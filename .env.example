# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2023-07-21
NEXT_PUBLIC_SANITY_ACCESS_TOKEN=
NEXT_PUBLIC_SANITY_HOOK_SECRET=

# GitHub Graph
NEXT_PUBLIC_GITHUB_USERNAME="your-github-username"
NEXT_PUBLIC_GITHUB_JOIN_YEAR="year-you-joined-github"

# Contact form (third-party form service, e.g. Formspree / Web3Forms / Getform)
# Must accept a JSON POST and return JSON. Example: https://formspree.io/f/xxxxxxxx
# When unset, the Dossera demo request form shows a graceful fallback message.
NEXT_PUBLIC_CONTACT_FORM_URL=
